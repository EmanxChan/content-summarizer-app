# ============================================================
# Content Summarizer — Environment Variables
# Copy this to .env.local for local development
# Add these same keys in Vercel → Settings → Environment Variables
# ============================================================

# Groq AI (required) — get at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Search (required) — get at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase (required for Phase 4+) — get at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
